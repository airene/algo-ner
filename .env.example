# HTTP server
APP_HOST=0.0.0.0
APP_PORT=8002
API_KEY=

# Runtime: use cpu on macOS Apple Silicon; use cuda:0 on Debian + NVIDIA GPU.
DEVICE=cpu
MODEL_CACHE_DIR=./models
MODEL_ID=iic/nlp_raner_named-entity-recognition_chinese-base-generic
MODEL_REVISION=master

# RaNER supports 512 positions, including two special tokens. Keep a conservative
# character limit; configuration values above 510 are rejected at startup.
MAX_INPUT_CHARACTERS=480
MAX_CONCURRENT_REQUESTS=4
